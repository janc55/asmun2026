# ==========================================
# ASMUN CONTROL - VARIABLES DE ENTORNO
# ==========================================

# Base de Datos PostgreSQL
DB_USER=asmun_user
DB_PASSWORD=asmun_secure_password
DB_NAME=asmun_db
DB_PORT=5432
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}?schema=public

# Backend (NestJS)
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=asmun_jwt_access_secret_super_secure_key_2026
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=asmun_jwt_refresh_secret_super_secure_key_2026
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGIN=http://localhost:3000

# Usuario Administrador Inicial (Seed)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminAsmun2026!
INITIAL_ADMIN_NAME="Administrador ASMUN"

# Configuración y Datos del Evento
EVENT_NAME="ASMUN 2026"
EVENT_SUBTITLE="Colegio Americano de Oruro"
EVENT_TIMEZONE="America/La_Paz"

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
API_URL=http://localhost:4000
