datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ParticipantRole {
  delegado
  docente
  mesa
  secretaria
  staff
  invitado
}

enum CheckpointType {
  ingreso
  credencial
  material
  refrigerio
  almuerzo
  otro
}

enum ScanResult {
  ok
  duplicado
  fuera_de_horario
  falta_requisito
  no_habilitado
  no_encontrado
  excepcion
  anulado
}

enum ScanSource {
  qr
  manual
  busqueda
}

enum UserRole {
  admin
  registrador
  operador
  lector
}

model School {
  id           Int           @id @default(autoincrement())
  name         String
  city         String?
  participants Participant[]

  @@map("schools")
}

model Committee {
  id           Int           @id @default(autoincrement())
  name         String
  shortName    String?       @map("short_name")
  participants Participant[]

  @@map("committees")
}

model Participant {
  id           Int             @id @default(autoincrement())
  code         String          @unique @db.Char(6)
  firstName    String          @map("first_name")
  lastName     String          @map("last_name")
  documentId   String?         @map("document_id")
  role         ParticipantRole
  position     String?
  schoolId     Int?            @map("school_id")
  school       School?         @relation(fields: [schoolId], references: [id])
  committeeId  Int?            @map("committee_id")
  committee    Committee?      @relation(fields: [committeeId], references: [id])
  country      String?
  dietaryNotes String?         @map("dietary_notes")
  notes        String?
  isActive     Boolean         @default(true) @map("is_active")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  scans        Scan[]

  @@index([lastName, firstName], map: "ix_participants_name")
  @@map("participants")
}

model Checkpoint {
  id                   Int               @id @default(autoincrement())
  name                 String
  type                 CheckpointType
  day                  DateTime          @db.Date
  startsAt             DateTime?         @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime?         @map("ends_at") @db.Timestamptz(3)
  requiresCheckpointId Int?              @map("requires_checkpoint_id")
  requiresCheckpoint   Checkpoint?       @relation("CheckpointDependencies", fields: [requiresCheckpointId], references: [id])
  dependentCheckpoints Checkpoint[]      @relation("CheckpointDependencies")
  appliesToRoles       ParticipantRole[] @map("applies_to_roles")
  isActive             Boolean           @default(true) @map("is_active")
  scans                Scan[]
  userCheckpoints      UserCheckpoint[]

  @@map("checkpoints")
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  fullName        String           @map("full_name")
  passwordHash    String           @map("password_hash")
  role            UserRole
  isActive        Boolean          @default(true) @map("is_active")
  scans           Scan[]           @relation("UserScans")
  voidedScans     Scan[]           @relation("VoidedScans")
  userCheckpoints UserCheckpoint[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Scan {
  id            String      @id @default(uuid()) @db.Uuid
  participantId Int?        @map("participant_id")
  participant   Participant? @relation(fields: [participantId], references: [id])
  checkpointId  Int         @map("checkpoint_id")
  checkpoint    Checkpoint  @relation(fields: [checkpointId], references: [id])
  userId        Int         @map("user_id")
  user          User        @relation("UserScans", fields: [userId], references: [id])
  result        ScanResult
  source        ScanSource
  scannedAt     DateTime    @default(now()) @map("scanned_at") @db.Timestamptz(3)
  note          String?
  voidedBy      Int?        @map("voided_by")
  voidedByUser  User?       @relation("VoidedScans", fields: [voidedBy], references: [id])
  voidedReason  String?     @map("voided_reason")

  @@map("scans")
}

model UserCheckpoint {
  userId       Int        @map("user_id")
  checkpointId Int        @map("checkpoint_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@id([userId, checkpointId])
  @@map("user_checkpoints")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("audit_log")
}
