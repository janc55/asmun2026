{
  "name": "asmun-control",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Registro, Credencialización y Control ASMUN",
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @asmun/api dev",
    "dev:web": "pnpm --filter @asmun/web dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "prisma:generate": "pnpm --filter @asmun/api prisma:generate",
    "prisma:migrate": "pnpm --filter @asmun/api prisma:migrate",
    "prisma:seed": "pnpm --filter @asmun/api prisma:seed"
  },
  "keywords": [
    "asmun",
    "nestjs",
    "nextjs",
    "prisma",
    "postgresql"
  ],
  "author": "Colegio Americano de Oruro / ASMUN",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0"
}
